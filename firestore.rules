rules_version = '2';

// ─────────────────────────────────────────────────────────────────
//  Al Toque · Reglas de Firestore
//  Roles: jugador | dueno  (antes era admin → ahora es dueno)
// ─────────────────────────────────────────────────────────────────

service cloud.firestore {
  match /databases/{database}/documents {

    // ── Helpers ────────────────────────────────────────────────
    function isAuthed() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return isAuthed() && request.auth.uid == uid;
    }

    function isDueno() {
      return isAuthed() &&
        exists(/databases/$(database)/documents/usuarios/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data.rol == 'dueno';
    }

    function isDuenoDeComplejo(complejoId) {
      return isAuthed() &&
        exists(/databases/$(database)/documents/usuarios/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data.rol == 'dueno' &&
        get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data.complejoId == complejoId;
    }

    // ── Usuarios ───────────────────────────────────────────────
    match /usuarios/{uid} {
      allow read: if isAuthed();
      // Crear perfil: jugador o dueno
      allow create: if isOwner(uid)
        && request.resource.data.rol in ['jugador', 'dueno'];
      // Actualizar: solo el dueño del doc, sin cambiar rol
      allow update: if isOwner(uid)
        && request.resource.data.rol == resource.data.rol;
      allow delete: if false;
    }

    // ── Complejos ──────────────────────────────────────────────
    match /complejos/{complejoId} {
      // Lectura pública: aparecen en el mapa y la lista del jugador
      allow read: if true;
      // Crear: solo dueños autenticados
      allow create: if isDueno();
      // Actualizar/eliminar: solo el dueño asignado a ese complejo
      allow update, delete: if isDuenoDeComplejo(complejoId);

      // Sub-colección: canchas
      match /canchas/{canchaId} {
        allow read: if true;
        // El dueño del complejo puede gestionar sus canchas.
        // Un dueño también puede crear canchas en complejos sin dueño
        // (necesario para el seeder de datos de demostración).
        allow write: if isDuenoDeComplejo(complejoId) ||
          (isDueno() &&
           get(/databases/$(database)/documents/complejos/$(complejoId)).data.duenoUid == '');
      }
    }

    // ── Reservas ───────────────────────────────────────────────
    match /reservas/{reservaId} {
      allow read: if isAuthed() && (
        resource.data.userId == request.auth.uid ||
        isDuenoDeComplejo(resource.data.complejoId)
      );
      allow create: if isAuthed()
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.estado in ['pendiente', 'confirmada'];
      allow update: if isAuthed() && (
        resource.data.userId == request.auth.uid ||
        isDuenoDeComplejo(resource.data.complejoId)
      );
      allow delete: if isDuenoDeComplejo(resource.data.complejoId);
    }

    // ── Partidos ───────────────────────────────────────────────
    match /partidos/{partidoId} {
      allow read: if isAuthed();
      allow create: if isAuthed()
        && request.resource.data.organizadorId == request.auth.uid;
      allow update: if isAuthed();
      allow delete: if isAuthed() && (
        resource.data.organizadorId == request.auth.uid || isDueno()
      );
    }

    // ── Flash Slots ────────────────────────────────────────────
    match /flashSlots/{slotId} {
      allow read: if isAuthed();
      allow write: if isDuenoDeComplejo(resource.data.complejoId);
    }

    // ── Predicciones IA ────────────────────────────────────────
    match /prediccionesIA/{predId} {
      allow read: if isAuthed();
      allow write: if isDueno();
    }

    // ── Reseñas ────────────────────────────────────────────────
    match /resenas/{resenaId} {
      allow read: if true;
      allow create: if isAuthed()
        && request.resource.data.userId == request.auth.uid;
      allow update: if isDuenoDeComplejo(resource.data.complejoId);
      allow delete: if false;
    }
  }
}
